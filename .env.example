# Copy to .env.local for development. Both values are safe in the browser:
# the anon key identifies the Supabase project and grants nothing on its own,
# because every table is behind row-level security.
#
# Service-role keys, OAuth client secrets and provider API keys must NEVER
# appear here -- they belong in Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
